# Optional OpenAI-compatible semantic analysis and transcription.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional explicit production speed path. Setting this to openai sends bounded
# five-minute speech-audio chunks to the configured OpenAI-compatible endpoint
# before trying local Whisper. Leave blank to keep local Whisper first.
BRAYO_TRANSCRIPTION_PROVIDER=
# 3 is suitable for local/built-in Whisper; 4 is suitable for remote I/O.
BRAYO_TRANSCRIPTION_CONCURRENCY=3

# Optional local Whisper CLI. Example: /opt/homebrew/bin/whisper
WHISPER_COMMAND=
WHISPER_MODEL=base

# Built-in local Whisper fallback (downloads and caches the model once).
LOCAL_WHISPER_MODEL=Xenova/whisper-tiny.en

# Required on Vercel: one private Backblaze B2 bucket. Find the endpoint and
# region on the bucket's S3-compatible details page. Create a non-master
# application key with listAllBucketNames, listFiles, readFiles, writeFiles and
# deleteFiles, restricted to this bucket (and optionally the `brayo/` prefix).
# Localhost continues to use SQLite and .data when these values are omitted.
B2_ENDPOINT=https://s3.YOUR-REGION.backblazeb2.com
B2_REGION=YOUR-REGION
B2_BUCKET_NAME=
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=

# Video uploads default to a 20 GiB limit when this setting is omitted.
MAX_VIDEO_UPLOAD_BYTES=21474836480

# Required on Vercel. Use the exact production HTTPS origin with no trailing
# slash. Direct B2 CORS and publishing callbacks are derived from this value.
# Register these callback URLs with the
# matching provider: ${APP_URL}/api/integrations/youtube/callback and
# ${APP_URL}/api/integrations/tiktok/callback (TikTok requires HTTPS).
APP_URL=http://localhost:3000
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
