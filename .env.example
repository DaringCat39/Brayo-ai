# Optional OpenAI-compatible semantic analysis and transcription.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional local Whisper CLI. Example: /opt/homebrew/bin/whisper
WHISPER_COMMAND=
WHISPER_MODEL=base

# Built-in local Whisper fallback (downloads and caches the model once).
LOCAL_WHISPER_MODEL=Xenova/whisper-tiny.en

# Optional production upload storage. Connect a private Vercel Blob store to
# enable browser-direct multipart video uploads. Without it, localhost keeps
# the existing streamed upload-to-disk path. Defaults to 2 GiB when omitted.
BLOB_READ_WRITE_TOKEN=
MAX_VIDEO_UPLOAD_BYTES=2147483648

# Optional direct publishing connections. Register these callback URLs with the
# matching provider: ${APP_URL}/api/integrations/youtube/callback and
# ${APP_URL}/api/integrations/tiktok/callback (TikTok requires HTTPS).
APP_URL=http://localhost:3000
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
