# Optional OpenAI-compatible semantic analysis and transcription.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional explicit production speed path. Setting this to openai sends bounded
# five-minute speech-audio chunks to the configured OpenAI-compatible endpoint
# before trying local Whisper. Leave blank to keep local Whisper first.
BRAYO_TRANSCRIPTION_PROVIDER=
# 3 is suitable for local/built-in Whisper; 4 is suitable for remote I/O.
BRAYO_TRANSCRIPTION_CONCURRENCY=3

# Optional local Whisper CLI. Example: /opt/homebrew/bin/whisper
WHISPER_COMMAND=
WHISPER_MODEL=base

# Built-in local Whisper fallback (downloads and caches the model once).
LOCAL_WHISPER_MODEL=Xenova/whisper-tiny.en

# Required on Vercel: connect one private Vercel Blob store for direct source
# uploads, durable project/account metadata, thumbnails, music and renders.
# Localhost continues to use SQLite and .data without this token.
# Video uploads default to a 2 GiB limit when the size setting is omitted.
BLOB_READ_WRITE_TOKEN=
MAX_VIDEO_UPLOAD_BYTES=2147483648

# Optional direct publishing connections. Register these callback URLs with the
# matching provider: ${APP_URL}/api/integrations/youtube/callback and
# ${APP_URL}/api/integrations/tiktok/callback (TikTok requires HTTPS).
APP_URL=http://localhost:3000
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
